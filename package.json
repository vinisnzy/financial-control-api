{
  "name": "financial-control-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file=.env src/main/server.ts",
    "start": "node .",
    "postinstall": "prisma generate",
    "test": "vitest --project unit",
    "test:db:up": "docker compose up -d financial-control-db-test",
    "test:db:down": "docker compose down financial-control-db-test",
    "test:integration": "npm run test:db:up && vitest run --project integration",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/node": "^25.2.2",
    "prisma": "^7.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.4",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4",
    "fastify-type-provider-zod": "^6.1.0",
    "zod": "^4.3.6"
  }
}